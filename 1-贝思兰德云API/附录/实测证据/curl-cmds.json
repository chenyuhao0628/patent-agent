  "file": "1-通用前置：认证与标识.md",
  "cmd": "curl -sS -k -X POST \"$API/Auth/GetToken\" \\\n  -H 'Content-Type: application/json' \\\n  -d \"{\\\"UserName\\\":\\\"<账号>\\\",\\\"Password\\\":\\\"$PW\\\"}\" \\\n  | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"Data\"][\"Token\"])')\nunset PW\ntest -n \"$TOKEN\" && printf '%s' \"$TOKEN\" > /tmp/baseland_token && chmod 600 /tmp/baseland_token\necho \"Token 已保存（${#TOKEN} 字符）\""
